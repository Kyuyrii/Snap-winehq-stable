#!/bin/bash
# wine-dot-desktop-creator - shortcut helper (Yad version)

APP_TITLE="Wine Dot Desktop Creator"

WINE_FALLBACK_ICON="/snap/winehq-stable/current/meta/gui/icon.svg"

XDG_CATEGORIES=(
    "Audio" "AudioVideo" "Development" "Education" "Game"
    "Graphics" "Network" "Office" "Science" "Settings"
    "System" "Utility" "Video"
)

WDDC_LOCALES=(
    "ar_SA.UTF-8" "bg_BG.UTF-8" "cs_CZ.UTF-8" "da_DK.UTF-8"
    "de_DE.UTF-8" "el_GR.UTF-8" "en_US.UTF-8" "es_ES.UTF-8"
    "es_MX.UTF-8" "fa_IR.UTF-8" "fi_FI.UTF-8" "fr_FR.UTF-8"
    "he_IL.UTF-8" "hi_IN.UTF-8" "hu_HU.UTF-8" "it_IT.UTF-8"
    "ja_JP.UTF-8" "ko_KR.UTF-8" "nb_NO.UTF-8" "nl_NL.UTF-8"
    "pl_PL.UTF-8" "pt_BR.UTF-8" "pt_PT.UTF-8" "ro_RO.UTF-8"
    "ru_RU.UTF-8" "sk_SK.UTF-8" "sv_SE.UTF-8" "th_TH.UTF-8"
    "tr_TR.UTF-8" "uk_UA.UTF-8" "zh_CN.UTF-8" "zh_TW.UTF-8"
)

# ---------- Dependency check ----------

if ! command -v yad >/dev/null 2>&1; then
    echo "[wddc]: 'yad' command not found" >&2
    exit 1
fi

HAVE_ICOUTILS=1
if ! command -v wrestool >/dev/null 2>&1; then
    HAVE_ICOUTILS=0
    echo "[wddc]: 'wrestool' command not found" >&2
elif ! command -v icotool >/dev/null 2>&1; then
    HAVE_ICOUTILS=0
    echo "[wddc]: 'icotool' command not found" >&2
fi

# ---------- Dialog helpers ----------

dlg_error() {
    local title="$1" text="$2"
    yad --error --title="$title" --text="$text" 2>/dev/null
}

dlg_select_exec() {
    local title="$1"
    yad --file --title="$title" \
        --file-filter="Windows executables | *.exe *.msi" \
        --file-filter="All files | *" 2>/dev/null
}

dlg_pick_icon_with_warning() {
    local title="$1" warning="$2"
    local out
    out=$(yad --form --title="$title" \
        --text="$warning" \
        --separator=$'\n' \
        --field=":FL" "" \
        --file-filter="Images | *.png *.jpg *.jpeg *.ico *.svg" \
        --button="$(msg create):0" \
        2>/dev/null)
    local rc=$?
    [ "$rc" -ne 0 ] && return 1
    printf '%s\n' "$out"
}

# ---------- Language detection ----------
LANG_CODE="${LC_ALL:-${LANG:-en}}"
LANG_CODE="${LANG_CODE%%.*}"
LANG_CODE="${LANG_CODE%%@*}"
LANG_CODE="${LANG_CODE:0:2}"
case "$LANG_CODE" in
    pt|en|es) ;;
    *) LANG_CODE="en" ;;
esac

msg() {
    local k="$1"
    case "${LANG_CODE}_${k}" in
        # English
        en_create)              echo "Create" ;;
        en_field_category)      echo "XDG category" ;;
        en_field_exec)          echo "Executable" ;;
        en_field_icon)          echo "Icon" ;;
        en_field_locale)        echo "Locale" ;;
        en_field_name)          echo "Name" ;;
        en_field_prefix)        echo "Wineprefix" ;;
        en_icon_extract_failed) echo "Icon extraction failed.\n\nSelect an image to use as the icon." ;;
        en_invalid_file)        echo "Invalid file, check the path used." ;;
        en_locale_indefinite)   echo "Indefinite" ;;
        en_select_exec_title)   echo "Select an executable" ;;

        # Portuguese
        pt_create)              echo "Criar" ;;
        pt_field_category)      echo "Categoria XDG" ;;
        pt_field_exec)          echo "Executável" ;;
        pt_field_icon)          echo "Ícone" ;;
        pt_field_locale)        echo "Localidade" ;;
        pt_field_name)          echo "Nome" ;;
        pt_field_prefix)        echo "Wineprefix" ;;
        pt_icon_extract_failed) echo "Extração de ícone falhou.\n\nSelecione uma imagem para ser o ícone" ;;
        pt_invalid_file)        echo "Arquivo inválido, verifique o caminho usado." ;;
        pt_locale_indefinite)   echo "Indefinido" ;;
        pt_select_exec_title)   echo "Selecione um executável" ;;

        # Spanish
        es_create)              echo "Crear" ;;
        es_field_category)      echo "Categoría XDG" ;;
        es_field_exec)          echo "Ejecutable" ;;
        es_field_icon)          echo "Icono" ;;
        es_field_locale)        echo "Localidad" ;;
        es_field_name)          echo "Nombre" ;;
        es_field_prefix)        echo "Wineprefix" ;;
        es_icon_extract_failed) echo "La extracción del icono falló.\n\nSeleccione una imagen para usar como icono." ;;
        es_invalid_file)        echo "Archivo inválido, verifique la ruta utilizada." ;;
        es_locale_indefinite)   echo "Indefinido" ;;
        es_select_exec_title)   echo "Seleccionar un ejecutable" ;;
    esac
}

# ---------- Helper functions ----------

get_desktop_dir() {
    local desktop="$HOME/Desktop"
    local config="$HOME/.config/user-dirs.dirs"
    if [ -f "$config" ]; then
        local xdg
        xdg=$(grep "^XDG_DESKTOP_DIR=" "$config" | cut -d'=' -f2- | tr -d '"')
        [ -n "$xdg" ] && desktop="${xdg/#\$HOME/$HOME}"
    fi
    echo "$desktop"
}

get_default_wine_prefix() {
    if [ -n "$SNAP_USER_COMMON" ]; then
        echo "$SNAP_USER_COMMON/.wine"
    else
        echo "$HOME/.wine"
    fi
}

get_largest_icon_size() {
    local ico_file="$1" max_size=0 size
    while IFS= read -r line; do
        if [[ $line =~ --width=([0-9]+) ]]; then
            size="${BASH_REMATCH[1]}"
            [ "$size" -gt "$max_size" ] && max_size=$size
        fi
    done < <(icotool -l "$ico_file" 2>/dev/null)
    echo "$max_size"
}

extract_exe_icon() {
    [ "$HAVE_ICOUTILS" -eq 1 ] || return 1

    local exe="$1" out_png="$2"
    local cache
    cache=$(mktemp -d)
    (
        cd "$cache" || exit 1
        wrestool -x -t 14 "$exe" > temp.ico 2>/dev/null || exit 1
        [ -s temp.ico ] || exit 1
        local sz
        sz=$(get_largest_icon_size "temp.ico")
        [ -z "$sz" ] || [ "$sz" -le 0 ] && exit 1
        icotool -x -w "$sz" -h "$sz" "temp.ico" >/dev/null 2>&1 || exit 1
        local png
        png=$(find . -maxdepth 1 -name "*.png" | head -1)
        [ -z "$png" ] && exit 1
        cp "$png" "$out_png"
    )
    local rc=$?
    rm -rf "$cache"
    return $rc
}

extract_ico_icon() {
    [ "$HAVE_ICOUTILS" -eq 1 ] || return 1

    local ico="$1" out_png="$2"
    local cache
    cache=$(mktemp -d)
    (
        cd "$cache" || exit 1
        icotool -x "$ico" >/dev/null 2>&1 || exit 1
        local best="" best_area=-1 png area w h
        for png in *.png; do
            [ -f "$png" ] || continue
            if [[ $png =~ _([0-9]+)x([0-9]+)x[0-9]+\.png$ ]]; then
                w="${BASH_REMATCH[1]}"
                h="${BASH_REMATCH[2]}"
                area=$((w * h))
            else
                area=0
            fi
            if [ "$area" -gt "$best_area" ]; then
                best="$png"
                best_area="$area"
            fi
        done
        [ -z "$best" ] && exit 1
        cp "$best" "$out_png"
    )
    local rc=$?
    rm -rf "$cache"
    return $rc
}

build_cb_list() {
    local current="$1"; shift
    local out=""
    local item
    for item in "$@"; do
        if [ "$item" = "$current" ]; then
            out+="^${item}!"
        else
            out+="${item}!"
        fi
    done
    out="${out%!}"
    printf '%s\n' "$out"
}

resolve_icon_choice() {
    local user_icon="$1" exe_file="$2" lc_ext="$3" safe_name="$4" exec_dir="$5"

    if [ -n "$user_icon" ]; then
        if [ ! -f "$user_icon" ]; then
            echo "$WINE_FALLBACK_ICON"
            return
        fi
        local ubase uext lc_uext uparent
        ubase=$(basename "$user_icon")
        uext="${ubase##*.}"
        lc_uext=$(echo "$uext" | tr '[:upper:]' '[:lower:]')
        uparent=$(dirname "$user_icon")
        case "$lc_uext" in
            ico)
                local ico_base="${ubase%.*}"
                local ico_safe
                ico_safe=$(echo "$ico_base" | tr ' ' '_' | tr '[:upper:]' '[:lower:]' \
                           | sed 's/[^a-zA-Z0-9_-]/_/g')
                local ico_out="$uparent/wddc-icon-${ico_safe}.png"
                if extract_ico_icon "$user_icon" "$ico_out"; then
                    echo "$ico_out"
                else
                    echo "$user_icon"
                fi
                ;;
            png|jpg|jpeg|svg)
                echo "$user_icon"
                ;;
            *)
                echo "$WINE_FALLBACK_ICON"
                ;;
        esac
        return
    fi

    if [ "$lc_ext" = "exe" ]; then
        local exe_out="$exec_dir/wddc-icon-${safe_name}.png"
        if extract_exe_icon "$exe_file" "$exe_out"; then
            echo "$exe_out"
            return
        fi
    fi

    local picked
    picked=$(dlg_pick_icon_with_warning "$APP_TITLE" "$(msg icon_extract_failed)")
    if [ -z "$picked" ] || [ ! -f "$picked" ]; then
        echo "$WINE_FALLBACK_ICON"
        return
    fi

    local pbase pext lc_pext pparent
    pbase=$(basename "$picked")
    pext="${pbase##*.}"
    lc_pext=$(echo "$pext" | tr '[:upper:]' '[:lower:]')
    pparent=$(dirname "$picked")
    case "$lc_pext" in
        ico)
            local ico_base="${pbase%.*}"
            local ico_safe
            ico_safe=$(echo "$ico_base" | tr ' ' '_' | tr '[:upper:]' '[:lower:]' \
                       | sed 's/[^a-zA-Z0-9_-]/_/g')
            local ico_out="$pparent/wddc-icon-${ico_safe}.png"
            if extract_ico_icon "$picked" "$ico_out"; then
                echo "$ico_out"
            else
                echo "$picked"
            fi
            ;;
        png|jpg|jpeg|svg)
            echo "$picked"
            ;;
        *)
            echo "$WINE_FALLBACK_ICON"
            ;;
    esac
}

# ---------- Create shortcut ----------

create_shortcut() {
    local exec_file="$1"

    if [ ! -f "$exec_file" ]; then
        dlg_error "$APP_TITLE" "$(msg invalid_file)"
        exit 1
    fi

    local base ext lc_ext
    base=$(basename "$exec_file")
    ext="${base##*.}"
    lc_ext=$(echo "$ext" | tr '[:upper:]' '[:lower:]')
    if [ "$lc_ext" != "exe" ] && [ "$lc_ext" != "msi" ]; then
        dlg_error "$APP_TITLE" "$(msg invalid_file)"
        exit 1
    fi

    local app_name="${base%.*}"
    local exec_dir desktop_dir dotfile
    exec_dir=$(dirname "$exec_file")
    desktop_dir="$DOT_DESKTOP_DIR"

    local found_prefix="" candidate
    candidate="$exec_dir"
    while [ "$candidate" != "/" ] && [ "$candidate" != "." ]; do
        if [ -d "$candidate/drive_c" ]; then
            found_prefix="$candidate"
            break
        fi
        candidate=$(dirname "$candidate")
    done

    if [ -z "$found_prefix" ]; then
        found_prefix="$(get_default_wine_prefix)"
        mkdir -p "$found_prefix" 2>/dev/null
    fi

    local f_name="$app_name"
    local f_prefix="$found_prefix"
    local f_icon=""
    local f_locale=""
    local f_category="Audio"

    local locale_items=("$(msg locale_indefinite)")
    locale_items+=("${WDDC_LOCALES[@]}")

    local cat_list
    cat_list=$(build_cb_list "$f_category" "${XDG_CATEGORIES[@]}")

    local locale_current_display="$f_locale"
    if [ -z "$locale_current_display" ]; then
        locale_current_display="$(msg locale_indefinite)"
    fi
    local locale_list
    locale_list=$(build_cb_list "$locale_current_display" "${locale_items[@]}")

    local form_out
    form_out=$(yad --form --title="$APP_TITLE" \
        --separator=$'\n' \
        --field="$(msg field_exec):RO" "$exec_file" \
        --field="$(msg field_name)" "$f_name" \
        --field="$(msg field_prefix):DIR" "$f_prefix" \
        --field="$(msg field_icon):FL" "$f_icon" \
        --field="$(msg field_locale):CB" "$locale_list" \
        --field="$(msg field_category):CB" "$cat_list" \
        --file-filter="Images | *.png *.jpg *.jpeg *.ico *.svg" \
        --button="$(msg create):0" \
        2>/dev/null)
    local rc=$?
    [ "$rc" -ne 0 ] && exit 0

    local p_exec p_name p_prefix p_icon p_locale p_category
    p_exec=$(printf '%s\n' "$form_out" | sed -n '1p')
    p_name=$(printf '%s\n' "$form_out" | sed -n '2p')
    p_prefix=$(printf '%s\n' "$form_out" | sed -n '3p')
    p_icon=$(printf '%s\n' "$form_out" | sed -n '4p')
    p_locale=$(printf '%s\n' "$form_out" | sed -n '5p')
    p_category=$(printf '%s\n' "$form_out" | sed -n '6p')

    if [ -z "$p_name" ]; then
        p_name="$app_name"
    fi
    if [ "$p_locale" = "$(msg locale_indefinite)" ]; then
        p_locale=""
    fi

    f_name="$p_name"
    f_prefix="$p_prefix"
    f_icon="$p_icon"
    f_locale="$p_locale"
    f_category="$p_category"

    local final_prefix="$f_prefix"
    if [ -z "$final_prefix" ]; then
        final_prefix="$found_prefix"
    fi

    local final_safe
    final_safe=$(echo "$f_name" | tr ' ' '_' | tr '[:upper:]' '[:lower:]' \
                 | sed 's/[^a-zA-Z0-9_-]/_/g')
    dotfile="$desktop_dir/wddc-$final_safe.desktop"

    local icon_path
    icon_path=$(resolve_icon_choice "$f_icon" "$exec_file" "$lc_ext" "$final_safe" "$exec_dir")
    [ -z "$icon_path" ] && icon_path="$WINE_FALLBACK_ICON"

    local env_parts=""
    if [ -n "$final_prefix" ]; then
        env_parts+="WINEPREFIX=\"$final_prefix\" "
    fi
    if [ -n "$f_locale" ]; then
        env_parts+="LC_ALL=$f_locale LANG=$f_locale LANGUAGE=$f_locale "
    fi

    local exec_line
    if [ -n "$env_parts" ]; then
        exec_line="env ${env_parts}snap run winehq-stable \"$exec_file\""
    else
        exec_line="snap run winehq-stable \"$exec_file\""
    fi

    local exec_basename
    exec_basename=$(basename "$exec_file")

    cat > "$dotfile" << EOF
[Desktop Entry]
Name=$f_name
Exec=$exec_line
Icon=$icon_path
Path=$exec_dir
StartupWMClass=$exec_basename
Categories=${f_category};
Keywords=wine;
Type=Application
StartupNotify=false
Terminal=false
EOF
    chmod +x "$dotfile"
}

# ---------- Entry point ----------

if [ -n "$SNAP" ]; then
    if snapctl is-connected home 2>/dev/null; then
        DOT_DESKTOP_DIR="$(get_desktop_dir)"
    else
        DOT_DESKTOP_DIR="$SNAP_USER_COMMON/Desktop"
        mkdir -p "$DOT_DESKTOP_DIR"
    fi
else
    DOT_DESKTOP_DIR="$(get_desktop_dir)"
fi

if [ -n "$1" ]; then
    create_shortcut "$1"
else
    exec_file=$(dlg_select_exec "$(msg select_exec_title)")
    [ -z "$exec_file" ] && exit 0
    create_shortcut "$exec_file"
fi
