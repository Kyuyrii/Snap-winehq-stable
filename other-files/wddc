#!/bin/bash
# wine-dot-desktop-creator - shortcut helper (Yad version)

APP_TITLE="Wine Dot Desktop Creator"

XDG_CATEGORIES=(
    "Audio" "AudioVideo" "Development" "Education" "Game"
    "Graphics" "Network" "Office" "Science" "Settings"
    "System" "Utility" "Video"
)

WINE_LOCALES=(
    "ar_SA.UTF-8" "bg_BG.UTF-8" "cs_CZ.UTF-8" "da_DK.UTF-8"
    "de_DE.UTF-8" "el_GR.UTF-8" "en_US.UTF-8" "es_ES.UTF-8"
    "es_MX.UTF-8" "fa_IR.UTF-8" "fi_FI.UTF-8" "fr_FR.UTF-8"
    "he_IL.UTF-8" "hi_IN.UTF-8" "hu_HU.UTF-8" "it_IT.UTF-8"
    "ja_JP.UTF-8" "ko_KR.UTF-8" "nb_NO.UTF-8" "nl_NL.UTF-8"
    "pl_PL.UTF-8" "pt_BR.UTF-8" "pt_PT.UTF-8" "ro_RO.UTF-8"
    "ru_RU.UTF-8" "sk_SK.UTF-8" "sv_SE.UTF-8" "th_TH.UTF-8"
    "tr_TR.UTF-8" "uk_UA.UTF-8" "zh_CN.UTF-8" "zh_TW.UTF-8"
)

# ---------- Dependency check ----------

if ! command -v yad >/dev/null 2>&1; then
    echo "[wddc]: yad is required but was not found in PATH." >&2
    echo "[wddc]: install it (e.g. 'sudo apt install yad' / 'sudo dnf install yad')." >&2
    exit 1
fi

HAVE_ICOUTILS=1
if ! command -v wrestool >/dev/null 2>&1 || ! command -v icotool >/dev/null 2>&1; then
    HAVE_ICOUTILS=0
    yad --warning --title="$APP_TITLE" \
        --text="'icoutils' (wrestool/icotool) was not found.\n\nAutomatic icon extraction from .exe and .ico files will be disabled; the icon will fall back to 'wine' (or to the .ico file itself if you pick one).\n\nInstall it (e.g. 'sudo apt install icoutils' / 'sudo dnf install icoutils') to enable icon extraction." \
        2>/dev/null
fi

# ---------- Dialog helpers ----------

dlg_error() {
    local title="$1" text="$2"
    yad --error --title="$title" --text="$text" 2>/dev/null
}

dlg_select_exec() {
    local title="$1"
    yad --file --title="$title" \
        --file-filter="Windows executables | *.exe *.msi" \
        --file-filter="All files | *" 2>/dev/null
}

# Fallback icon picker: shows the warning message AND the FL button
# in the same window, mirroring the main form's look.
dlg_pick_icon_with_warning() {
    local title="$1" warning="$2"
    local out
    out=$(yad --form --title="$title" \
        --text="$warning" \
        --separator=$'\n' \
        --field="$(msg field_icon):FL" "" \
        --file-filter="Images | *.png *.jpg *.jpeg *.ico *.svg" \
        --button="$(msg cancel):1" \
        --button="$(msg confirm):0" \
        2>/dev/null)
    local rc=$?
    [ "$rc" -ne 0 ] && return 1
    printf '%s\n' "$out"
}

# ---------- Language detection ----------
LANG_CODE="${LC_ALL:-${LANG:-en}}"
LANG_CODE="${LANG_CODE%%.*}"
LANG_CODE="${LANG_CODE%%@*}"
LANG_CODE="${LANG_CODE:0:2}"
case "$LANG_CODE" in
    pt|en|es) ;;
